{
  "name": "@truesend/indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Watches TrueSend policies for holds, tells the owner and the guardian, and serves risk queries.",
  "license": "MIT",
  "scripts": {
    "dev": "tsc -p tsconfig.build.json && node dist/main.js",
