# ---- local toolchain (downloaded, not source) ----
.tools/

# ---- node ----
node_modules/
.pnpm-store/
*.tsbuildinfo
dist/
build/
.next/
.turbo/
coverage/
.output/
# The static export pages.yml publishes, when built locally to check it first.
apps/web/out/

# ---- foundry ----
contracts/out/
contracts/cache/
# Left behind when forge is run from the repo root rather than from contracts/.
/cache/
/out/
contracts/broadcast/
# Local chain addresses are deterministic and meaningless off this machine; a real deployment's
# address book is committed so the app can read it.
contracts/deployments/31337.json
contracts/deployments/registry-31337.json
contracts/.gas-snapshot.tmp

# ---- env & secrets ----
.env
.env.*
!.env.example

# ---- indexer ----
apps/indexer/.ponder/
apps/indexer/generated/
*.sqlite
*.sqlite-journal
*.db
*.db-shm
*.db-wal

# ---- extension ----
apps/extension/.wxt/
apps/extension/.output/
# Bundled from dev/harness.ts by `pnpm --filter @truesend/extension harness`.
apps/extension/dev/harness.js

# ---- python / analysis ----
# Raw chain reads cached so an interrupted replay resumes; the committed results are in analysis/data.
analysis/.cache/
__pycache__/
*.py[cod]
.venv/
.ipynb_checkpoints/

# ---- os / editor ----
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
