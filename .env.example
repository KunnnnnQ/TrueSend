# ---- chain access -------------------------------------------------------
# Any Sepolia RPC that supports EIP-7702 (Prague). Alchemy, Infura and
# public endpoints all work.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Used by `forge verify-contract` after deploying.
ETHERSCAN_API_KEY=

# ---- deployment ---------------------------------------------------------
# Deployments use a keystore rather than a raw key:
#   cast wallet import truesend-deployer --interactive
#   forge script script/Deploy.s.sol --account truesend-deployer --rpc-url sepolia --broadcast
# Never put a private key in this file.

# ---- app ----------------------------------------------------------------
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
