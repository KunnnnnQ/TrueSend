# ---- chain access -------------------------------------------------------
# Any Sepolia RPC that supports EIP-7702 (Prague).
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Used by `forge verify-contract` after deploying.
ETHERSCAN_API_KEY=

# ---- deployment ---------------------------------------------------------
# Deployments use a keystore rather than a raw key:
#   cast wallet import truesend-deployer --interactive
#   forge script script/Deploy.s.sol --account truesend-deployer --rpc-url sepolia --broadcast
# Never put a private key in this file.

# ---- web app (apps/web/.env.local) --------------------------------------
# History is read directly from an RPC. Mainnet needs one that answers archive
# queries, because the Scan screen looks back further than a pruned node keeps.
# analysis/src/rpc.mjs records which public endpoints do.
NEXT_PUBLIC_MAINNET_RPC=https://rpc.mevblocker.io
NEXT_PUBLIC_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com

# Filled in from contracts/deployments/<chainid>.json after deploying. Until
# these are set, Send and Pending say the chain has no policy rather than
# pointing at a placeholder.
NEXT_PUBLIC_SEPOLIA_VAULT_FACTORY=
NEXT_PUBLIC_SEPOLIA_GUARDED_ACCOUNT=
NEXT_PUBLIC_ANVIL_VAULT_FACTORY=
NEXT_PUBLIC_ANVIL_GUARDED_ACCOUNT=

# The community registry (docs/registry.md). EAS itself is a known constant for
# mainnet and Sepolia (packages/chain/src/registry.ts) and needs no variable
# here; PoisonRegistry is a fresh deployment per network, from
# contracts/deployments/registry-<chainid>.json. Until set, the Report screen
# says the registry is not configured rather than pointing a write at nothing.
NEXT_PUBLIC_SEPOLIA_POISON_REGISTRY=
NEXT_PUBLIC_MAINNET_POISON_REGISTRY=

# A local chain has no EAS at all, so LocalEas.s.sol deploys a fresh one on
# every run (contracts/deployments/registry-31337.json has the addresses).
NEXT_PUBLIC_ANVIL_EAS=
NEXT_PUBLIC_ANVIL_SCHEMA_REGISTRY=
NEXT_PUBLIC_ANVIL_POISON_REGISTRY=
